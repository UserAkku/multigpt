generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  MEMBER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum KnowledgeType {
  FINDING
  RESEARCH
  REQUIREMENT
  NOTE
  FACT
}

enum DecisionStatus {
  PROPOSED
  UNDER_REVIEW
  CONFIRMED
  REJECTED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id             String           @id @default(cuid())
  name           String
  avatarInitials String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  projects       Project[]        @relation("ProjectOwner")
  memberships    ProjectMember[]
  messages       Message[]
  comments       MessageComment[]
  knowledge      KnowledgeItem[]
  decisions      Decision[]
  tasksCreated   Task[]           @relation("TaskCreator")
  tasksAssigned  Task[]           @relation("TaskAssignee")
  activities     Activity[]
}

model Project {
  id           String           @id @default(cuid())
  name         String
  description  String           @default("")
  createdById  String
  createdBy    User             @relation("ProjectOwner", fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  members      ProjectMember[]
  conversations Conversation[]
  knowledge    KnowledgeItem[]
  decisions    Decision[]
  tasks        Task[]
  activities   Activity[]
  chunks       ConversationChunk[]
  files        ProjectFile[]
}

model ProjectMember {
  id        String     @id @default(cuid())
  projectId String
  userId    String
  role      MemberRole @default(MEMBER)
  joinedAt  DateTime   @default(now())
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([projectId, userId])
}

model Conversation {
  id                   String         @id @default(cuid())
  projectId            String
  title                String
  description          String?
  createdById          String
  provider             String         @default("mistral")
  model                String         @default("mistral-small-latest")
  parentConversationId String?
  branchName           String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  project              Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages             Message[]
  sourceKnowledge      KnowledgeItem[]
  sourceDecisions      Decision[]
  sourceTasks          Task[]
  chunks               ConversationChunk[]
  @@index([projectId, updatedAt])
}

model Message {
  id             String         @id @default(cuid())
  conversationId String
  userId         String?
  role           MessageRole
  content        String
  provider       String?
  model          String?
  createdAt      DateTime       @default(now())
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id])
  comments       MessageComment[]
  sourceKnowledge KnowledgeItem[] @relation("KnowledgeSourceMessage")
  sourceDecisions Decision[]      @relation("DecisionSourceMessage")
  @@index([conversationId, createdAt])
}

model MessageComment {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model KnowledgeItem {
  id                   String        @id @default(cuid())
  projectId            String
  title                String
  content              String
  type                 KnowledgeType
  sourceConversationId String?
  sourceMessageId      String?
  createdById          String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  project              Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceConversation   Conversation? @relation(fields: [sourceConversationId], references: [id])
  sourceMessage        Message?      @relation("KnowledgeSourceMessage", fields: [sourceMessageId], references: [id])
  createdBy            User          @relation(fields: [createdById], references: [id])
  @@index([projectId, type])
}

model Decision {
  id                   String         @id @default(cuid())
  projectId            String
  title                String
  description          String
  reason               String
  alternatives         String?
  status               DecisionStatus @default(PROPOSED)
  sourceConversationId String?
  sourceMessageId      String?
  createdById          String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  project              Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceConversation   Conversation?  @relation(fields: [sourceConversationId], references: [id])
  sourceMessage        Message?       @relation("DecisionSourceMessage", fields: [sourceMessageId], references: [id])
  createdBy            User           @relation(fields: [createdById], references: [id])
  tasks                Task[]
  @@index([projectId, status])
}

model Task {
  id                   String      @id @default(cuid())
  projectId            String
  title                String
  description          String      @default("")
  status               TaskStatus  @default(TODO)
  priority             Priority    @default(MEDIUM)
  assignedToId         String?
  sourceConversationId String?
  sourceDecisionId     String?
  createdById          String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  project              Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo           User?       @relation("TaskAssignee", fields: [assignedToId], references: [id])
  sourceConversation   Conversation? @relation(fields: [sourceConversationId], references: [id])
  sourceDecision       Decision?   @relation(fields: [sourceDecisionId], references: [id])
  createdBy            User        @relation("TaskCreator", fields: [createdById], references: [id])
  @@index([projectId, status])
}

model Activity {
  id         String   @id @default(cuid())
  projectId  String
  actorId    String
  eventType  String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor      User     @relation(fields: [actorId], references: [id])
  @@index([projectId, createdAt])
}

model ConversationChunk {
  id             String   @id @default(cuid())
  conversationId String
  projectId      String
  content        String
  messageStartId String?
  messageEndId   String?
  embedding      Unsupported("vector(1024)")?
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId])
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  name      String
  url       String
  mimeType  String
  size      Int
  uploadedById String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, createdAt])
}
